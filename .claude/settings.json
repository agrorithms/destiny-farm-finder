{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-dev-server.sh\"",
            "timeout": 10,
            "statusMessage": "Checking port 3000"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-build.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for a running build"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for destructive removal"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-orphan-check.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(npm uninstall:*)",
      "Bash(npm rm:*)",
      "Bash(npm remove:*)",
      "Bash(npm prune:*)"
    ]
  }
}
